{
  "$defs": {
    "AIReviewFailure": {
      "additionalProperties": false,
      "description": "Safe, typed provenance for a rejected AI-planning request.",
      "properties": {
        "mode": {
          "enum": [
            "live",
            "replay",
            "off"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_request_attempted": {
          "type": "boolean"
        },
        "reason_code": {
          "enum": [
            "provider_unavailable",
            "provider_failure",
            "budget_limit",
            "budget_state",
            "token_limit",
            "invalid_output",
            "plan_rejected",
            "unsupported_scope",
            "replay_mismatch"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "provider_request_attempted",
        "model",
        "reason_code"
      ],
      "title": "AIReviewFailure",
      "type": "object"
    },
    "BudgetStatus": {
      "additionalProperties": false,
      "description": "Non-sensitive application-level accounting summary; never includes prompt content.",
      "properties": {
        "project_budget_usd": {
          "minimum": 0,
          "type": "number"
        },
        "remaining_usd": {
          "minimum": 0,
          "type": "number"
        },
        "request_count": {
          "minimum": 0,
          "type": "integer"
        },
        "reserved_usd": {
          "minimum": 0,
          "type": "number"
        },
        "spent_usd": {
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "project_budget_usd",
        "spent_usd",
        "reserved_usd",
        "remaining_usd",
        "request_count"
      ],
      "title": "BudgetStatus",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "Execution outcome of one planned check.",
      "properties": {
        "applicable_count": {
          "description": "Elements the check applied to.",
          "minimum": 0,
          "type": "integer"
        },
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostics": {
          "description": "Engine messages; required for status 'error'.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not_applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "requirement_id",
        "status",
        "applicable_count",
        "finding_ids",
        "diagnostics"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckSpec": {
      "additionalProperties": false,
      "description": "One executable check, compiled from exactly one requirement.",
      "properties": {
        "id": {
          "default": "",
          "description": "Content hash of kind, rule_id, rule_version and payload. Derived automatically when omitted; rejected when supplied and inconsistent.",
          "type": "string"
        },
        "ids_specification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Serialised IDS 1.0 <specification> element for ids checks."
        },
        "kind": {
          "enum": [
            "ids",
            "native"
          ],
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Native rule parameters; must be empty for ids checks.",
          "type": "object"
        },
        "rule_id": {
          "description": "IDS specification reference (``ids:<name>``) or registered native rule id.",
          "examples": [
            "ids:External walls carry a fire rating",
            "naming.pattern"
          ],
          "minLength": 1,
          "type": "string"
        },
        "rule_version": {
          "description": "IDS: hash of the specification XML. Native: the rule's semantic version.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "rule_id",
        "rule_version",
        "ids_specification",
        "params"
      ],
      "title": "CheckSpec",
      "type": "object"
    },
    "ClassificationRef": {
      "additionalProperties": false,
      "description": "A classification reference attached to an element, directly or through its type.",
      "properties": {
        "identification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reference code (IFC4 Identification / IFC2X3 ItemReference)."
        },
        "inherited": {
          "description": "True when inherited from the element's type object.",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Name of the IfcClassification, when resolvable."
        }
      },
      "required": [
        "system",
        "identification",
        "name",
        "inherited"
      ],
      "title": "ClassificationRef",
      "type": "object"
    },
    "DocumentImport": {
      "additionalProperties": false,
      "description": "Result of importing one document: its identity and the requirements it established.",
      "properties": {
        "kind": {
          "enum": [
            "ids",
            "text",
            "markdown"
          ],
          "type": "string"
        },
        "requirements": {
          "description": "Requirements derived from this document, in document order.",
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "type": "array"
        },
        "sha256": {
          "description": "SHA-256 of the stored document bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "title": {
          "description": "Document title as declared inside the file.",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "kind",
        "title",
        "requirements"
      ],
      "title": "DocumentImport",
      "type": "object"
    },
    "ElementRecord": {
      "additionalProperties": false,
      "description": "Denormalised Model Index entry for one product, type object or spatial element.",
      "properties": {
        "classifications": {
          "description": "Classification references in (system, identification, name) order.",
          "items": {
            "$ref": "#/$defs/ClassificationRef"
          },
          "type": "array"
        },
        "container": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct or aggregate-inherited spatial container, if any."
        },
        "object_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "IfcObject.ObjectType attribute."
        },
        "predefined_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Resolved PredefinedType (instance, then type, USERDEFINED→ObjectType/ElementType)."
        },
        "psets": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/PropertyValue"
            },
            "type": "object"
          },
          "description": "Property and quantity sets keyed by set name, then property name.",
          "type": "object"
        },
        "ref": {
          "$ref": "#/$defs/ElementRef"
        },
        "type_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ElementRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The IfcTypeObject this occurrence is typed by, if any."
        }
      },
      "required": [
        "ref",
        "object_type",
        "predefined_type",
        "type_ref",
        "container",
        "psets",
        "classifications"
      ],
      "title": "ElementRecord",
      "type": "object"
    },
    "ElementRef": {
      "additionalProperties": false,
      "description": "A reference to one entity in the uploaded model.",
      "properties": {
        "express_id": {
          "description": "STEP instance id (#n) within the stored file.",
          "minimum": 1,
          "type": "integer"
        },
        "global_id": {
          "anyOf": [
            {
              "description": "22-character IFC GUID.",
              "pattern": "^[0-9A-Za-z_$]{22}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "IFC GlobalId; None for entities that are not IfcRoot subtypes."
        },
        "ifc_type": {
          "examples": [
            "IfcWall"
          ],
          "pattern": "^Ifc[A-Za-z0-9]+$",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the containing storey."
        }
      },
      "required": [
        "global_id",
        "express_id",
        "ifc_type",
        "name",
        "storey"
      ],
      "title": "ElementRef",
      "type": "object"
    },
    "EvidenceCitation": {
      "additionalProperties": false,
      "description": "Exact deterministic provenance cited by one explanation.",
      "properties": {
        "expected": {
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "type": "string"
        },
        "global_id": {
          "minLength": 1,
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "global_id",
        "requirement_id",
        "rule_id",
        "expected",
        "observed"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "description": "Interpretation kept separate from immutable deterministic Finding records.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/EvidenceCitation"
          },
          "type": "array"
        },
        "corrective_action": {
          "minLength": 1,
          "type": "string"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "enum": [
                "ai_disabled",
                "unsupported_evidence",
                "budget_limit",
                "ai_request_failed",
                "ai_output_invalid",
                "grounding_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why a deterministic template was returned instead of an AI interpretation: ``ai_disabled`` (no client configured), ``unsupported_evidence`` (evidence cannot be grounded safely), ``budget_limit`` (an application budget, call or token limit), ``ai_request_failed``, ``ai_output_invalid`` (schema-invalid response) or ``grounding_failed``. Always null for ``ai_generated``."
        },
        "finding_id": {
          "minLength": 1,
          "type": "string"
        },
        "grounding_status": {
          "enum": [
            "passed",
            "fallback"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probable_cause": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "enum": [
            "ai_generated",
            "deterministic_template"
          ],
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "summary",
        "probable_cause",
        "corrective_action",
        "citations",
        "source",
        "grounding_status",
        "model",
        "fallback_reason"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One verified defect affecting one or more elements.",
      "properties": {
        "category": {
          "examples": [
            "property_missing",
            "classification_missing",
            "prohibited_entity"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "check_id": {
          "description": "Id of the CheckSpec that produced it.",
          "minLength": 1,
          "type": "string"
        },
        "elements": {
          "description": "Affected elements, canonical order.",
          "items": {
            "$ref": "#/$defs/ElementRef"
          },
          "minItems": 1,
          "type": "array"
        },
        "expected": {
          "description": "What the requirement demanded.",
          "type": "string"
        },
        "facet_index": {
          "description": "Index of the failing requirement facet within the check; 0 for native.",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "default": "",
          "description": "sha1(check_id | rule_version | facet_index | sorted element keys)[:16]. Derived automatically when omitted; rejected when supplied and inconsistent.",
          "type": "string"
        },
        "method": {
          "enum": [
            "ids",
            "native"
          ],
          "type": "string"
        },
        "observed": {
          "description": "What the deterministic engine found.",
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "check_id",
        "requirement_id",
        "rule_id",
        "rule_version",
        "facet_index",
        "severity",
        "category",
        "elements",
        "observed",
        "expected",
        "method"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InputManifest": {
      "additionalProperties": false,
      "description": "Everything that determines a run's findings; two runs with equal manifests must agree.",
      "properties": {
        "ids_hashes": {
          "items": {
            "description": "Lower-case SHA-256 hex.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "model_hash": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "requirement_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "rule_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "model_hash",
        "ids_hashes",
        "requirement_revisions",
        "rule_versions"
      ],
      "title": "InputManifest",
      "type": "object"
    },
    "JsonValue": {},
    "ModelSummary": {
      "additionalProperties": false,
      "description": "Headline facts about an uploaded model, produced once per upload.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Number of instances per IFC class, keyed by class name (e.g. IfcWall).",
          "type": "object"
        },
        "ifc_schema": {
          "description": "Schema identifier read from the file.",
          "examples": [
            "IFC4"
          ],
          "type": "string"
        },
        "model_hash": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storeys": {
          "description": "Building storeys in file order.",
          "items": {
            "$ref": "#/$defs/ElementRef"
          },
          "type": "array"
        }
      },
      "required": [
        "ifc_schema",
        "model_hash",
        "project_name",
        "counts",
        "storeys"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "PlannedCheck": {
      "additionalProperties": false,
      "description": "A plan item: which confirmed check to run and why. Never carries parameters.",
      "properties": {
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "reason"
      ],
      "title": "PlannedCheck",
      "type": "object"
    },
    "ProblemDetail": {
      "additionalProperties": false,
      "description": "``application/problem+json`` body.",
      "properties": {
        "ai_review_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/AIReviewFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe AI-planning failure provenance when an AI-required review is rejected."
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request correlation id for matching against the run log."
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Occurrence-specific explanation."
        },
        "instance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URI of the specific occurrence."
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        "title": {
          "description": "Short, stable summary of the problem type.",
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "default": "about:blank",
          "description": "URI identifying the problem type.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "correlation_id",
        "ai_review_failure"
      ],
      "title": "ProblemDetail",
      "type": "object"
    },
    "PropertyValue": {
      "additionalProperties": false,
      "description": "One property or quantity value with its provenance (C-03).\n\n``value`` is the value as IfcOpenShell reads it: a scalar, a list for enumerations, or an\nobject for bounded, table and complex properties. It carries no field description because\na ``description`` beside ``$ref`` makes json-schema-to-typescript emit an object type.",
      "properties": {
        "inherited": {
          "description": "True when the value comes from the element's type object rather than being defined on the element itself.",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "value",
        "inherited"
      ],
      "title": "PropertyValue",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A single reviewable requirement bound to exactly one CheckSpec.",
      "properties": {
        "check": {
          "$ref": "#/$defs/CheckSpec"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model self-report; a sorting aid only."
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Revision the user confirmed, if any."
        },
        "id": {
          "examples": [
            "REQ-001"
          ],
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "enum": [
            "document",
            "ids",
            "builtin"
          ],
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed",
            "edited",
            "rejected",
            "informational"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "origin",
        "source",
        "check",
        "status",
        "confidence",
        "revision",
        "confirmed_revision",
        "confirmed_by",
        "confirmed_at"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementCandidate": {
      "additionalProperties": false,
      "description": "Unconfirmed narrative candidate; it can only reference an existing immutable check.",
      "properties": {
        "check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing confirmed CheckSpec id; null when no safe mapping is available."
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "document_kind": {
          "enum": [
            "text",
            "markdown"
          ],
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/RequirementSource"
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "informational"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "source",
        "document_kind",
        "check_id",
        "confidence",
        "status"
      ],
      "title": "RequirementCandidate",
      "type": "object"
    },
    "RequirementCandidateBatch": {
      "additionalProperties": false,
      "description": "Unconfirmed candidates returned for one narrative document.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/RequirementCandidate"
          },
          "type": "array"
        },
        "document_id": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "document_kind": {
          "enum": [
            "text",
            "markdown"
          ],
          "type": "string"
        },
        "rejected_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "document_id",
        "document_kind",
        "candidates",
        "rejected_count"
      ],
      "title": "RequirementCandidateBatch",
      "type": "object"
    },
    "RequirementCandidateConfirmation": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "$ref": "#/$defs/RequirementCandidate"
        },
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "confirmed_by": {
          "default": "user",
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "check_id",
        "confirmed_by"
      ],
      "title": "RequirementCandidateConfirmation",
      "type": "object"
    },
    "RequirementExtractionRequest": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "document_kind": {
          "enum": [
            "text",
            "markdown"
          ],
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "document_kind"
      ],
      "title": "RequirementExtractionRequest",
      "type": "object"
    },
    "RequirementSource": {
      "additionalProperties": false,
      "description": "Where a document-derived requirement came from; the quote is verbatim (FR-REQ-02).",
      "properties": {
        "document_id": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "location": {
          "description": "Paragraph or page identifier.",
          "minLength": 1,
          "type": "string"
        },
        "quote": {
          "description": "Exact substring of the extracted text.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "location",
        "quote"
      ],
      "title": "RequirementSource",
      "type": "object"
    },
    "ReviewPlan": {
      "additionalProperties": false,
      "description": "The ordered set of checks a run intends to execute (plan-then-execute, C-01).",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/PlannedCheck"
          },
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "title": "ReviewPlan",
      "type": "object"
    },
    "ReviewProvenance": {
      "additionalProperties": false,
      "description": "Persisted AI planning and execution provenance; absent on historical runs.",
      "properties": {
        "ai_planning_requested": {
          "type": "boolean"
        },
        "deterministic_fallback": {
          "default": false,
          "type": "boolean"
        },
        "executed_check_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "enum": [
            "live",
            "replay",
            "off"
          ],
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "enum": [
            "not_requested",
            "accepted",
            "rejected",
            "continued_without_ai"
          ],
          "type": "string"
        },
        "provider_request_attempted": {
          "type": "boolean"
        },
        "selected_check_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ai_planning_requested",
        "provider_request_attempted",
        "mode",
        "model",
        "outcome",
        "fallback_reason",
        "deterministic_fallback",
        "selected_check_ids",
        "executed_check_ids"
      ],
      "title": "ReviewProvenance",
      "type": "object"
    },
    "ReviewRequest": {
      "additionalProperties": false,
      "description": "Bounded review intent; an objective requires AI unless explicitly made optional.",
      "properties": {
        "ai_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether an objective requires an accepted AI plan. When omitted, a supplied objective requires AI; a request without an objective uses the deterministic plan."
        },
        "continue_without_ai": {
          "default": false,
          "description": "Explicitly choose the deterministic alternative after an AI-required request.",
          "type": "boolean"
        },
        "objective": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-language review objective. It must contain visible text; whitespace-only objectives are rejected rather than sent to the planner."
        },
        "selected_checks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SelectedCheck"
              },
              "maxItems": 50,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional confirmed-check scope, each pinned to its requirement revision. The model may select only within this scope."
        }
      },
      "required": [
        "objective",
        "ai_required",
        "continue_without_ai",
        "selected_checks"
      ],
      "title": "ReviewRequest",
      "type": "object"
    },
    "ReviewRun": {
      "additionalProperties": false,
      "description": "One review run over a session; the only record that carries timestamps.",
      "properties": {
        "check_results": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "input_manifest": {
          "$ref": "#/$defs/InputManifest"
        },
        "plan": {
          "$ref": "#/$defs/ReviewPlan"
        },
        "plan_source": {
          "enum": [
            "llm",
            "default"
          ],
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "partial",
            "failed",
            "interrupted"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "session_id",
        "status",
        "plan",
        "plan_source",
        "provenance",
        "check_results",
        "input_manifest",
        "created_at",
        "finished_at"
      ],
      "title": "ReviewRun",
      "type": "object"
    },
    "SelectedCheck": {
      "additionalProperties": false,
      "description": "A user-selected check pinned to the confirmed requirement revision it came from.",
      "properties": {
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "requirement_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "check_id",
        "requirement_id",
        "requirement_revision"
      ],
      "title": "SelectedCheck",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "description": "Session metadata as returned by ``GET /sessions/{sid}``. Never carries file paths.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "document_hashes": {
          "description": "SHA-256 of each uploaded requirement document.",
          "items": {
            "description": "Lower-case SHA-256 hex.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "Lower-case, hyphenated UUID4.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "model_hash": {
          "anyOf": [
            {
              "description": "Lower-case SHA-256 hex.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 of the stored IFC bytes; None until uploaded."
        },
        "status": {
          "description": "'created' until an IFC has been indexed, then 'model_ready'.",
          "enum": [
            "created",
            "model_ready"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "created_at",
        "status",
        "model_hash",
        "document_hashes"
      ],
      "title": "Session",
      "type": "object"
    }
  },
