{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "description": "Execution outcome of one planned check.",
      "properties": {
        "applicable_count": {
          "description": "Elements the check applied to.",
          "minimum": 0,
          "type": "integer"
        },
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "diagnostics": {
          "description": "Engine messages; required for status 'error'.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not_applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "requirement_id",
        "status",
        "applicable_count",
        "finding_ids",
        "diagnostics"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckSpec": {
      "additionalProperties": false,
      "description": "One executable check, compiled from exactly one requirement.",
      "properties": {
        "id": {
          "default": "",
          "description": "Content hash of kind, rule_id, rule_version and payload. Derived automatically when omitted; rejected when supplied and inconsistent.",
          "type": "string"
        },
        "ids_specification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Serialised IDS 1.0 <specification> element for ids checks."
        },
        "kind": {
          "enum": [
            "ids",
            "native"
          ],
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Native rule parameters; must be empty for ids checks.",
          "type": "object"
        },
        "rule_id": {
          "description": "IDS specification reference (``ids:<name>``) or registered native rule id.",
          "examples": [
            "ids:External walls carry a fire rating",
            "naming.pattern"
          ],
          "minLength": 1,
          "type": "string"
        },
        "rule_version": {
          "description": "IDS: hash of the specification XML. Native: the rule's semantic version.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "rule_id",
        "rule_version",
        "ids_specification",
        "params"
      ],
      "title": "CheckSpec",
      "type": "object"
    },
    "ElementRef": {
      "additionalProperties": false,
      "description": "A reference to one entity in the uploaded model.",
      "properties": {
        "express_id": {
          "description": "STEP instance id (#n) within the stored file.",
          "minimum": 1,
          "type": "integer"
        },
        "global_id": {
          "anyOf": [
            {
              "description": "22-character IFC GUID.",
              "pattern": "^[0-9A-Za-z_$]{22}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "IFC GlobalId; None for entities that are not IfcRoot subtypes."
        },
        "ifc_type": {
          "examples": [
            "IfcWall"
          ],
          "pattern": "^Ifc[A-Za-z0-9]+$",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the containing storey."
        }
      },
      "required": [
        "global_id",
        "express_id",
        "ifc_type",
        "name",
        "storey"
      ],
      "title": "ElementRef",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One verified defect affecting one or more elements.",
      "properties": {
        "category": {
          "examples": [
            "property_missing",
            "classification_missing",
            "prohibited_entity"
          ],
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "check_id": {
          "description": "Id of the CheckSpec that produced it.",
          "minLength": 1,
          "type": "string"
        },
        "elements": {
          "description": "Affected elements, canonical order.",
          "items": {
            "$ref": "#/$defs/ElementRef"
          },
          "minItems": 1,
          "type": "array"
        },
        "expected": {
          "description": "What the requirement demanded.",
          "type": "string"
        },
        "facet_index": {
          "description": "Index of the failing requirement facet within the check; 0 for native.",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "default": "",
          "description": "sha1(check_id | rule_version | facet_index | sorted element keys)[:16]. Derived automatically when omitted; rejected when supplied and inconsistent.",
          "type": "string"
        },
        "method": {
          "enum": [
            "ids",
            "native"
          ],
          "type": "string"
        },
        "observed": {
          "description": "What the deterministic engine found.",
          "type": "string"
        },
        "requirement_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "check_id",
        "requirement_id",
        "rule_id",
        "rule_version",
        "facet_index",
        "severity",
        "category",
        "elements",
        "observed",
        "expected",
        "method"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InputManifest": {
      "additionalProperties": false,
      "description": "Everything that determines a run's findings; two runs with equal manifests must agree.",
      "properties": {
        "ids_hashes": {
          "items": {
            "description": "Lower-case SHA-256 hex.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "model_hash": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "requirement_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "rule_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "model_hash",
        "ids_hashes",
        "requirement_revisions",
        "rule_versions"
      ],
      "title": "InputManifest",
      "type": "object"
    },
    "JsonValue": {},
    "ModelSummary": {
      "additionalProperties": false,
      "description": "Headline facts about an uploaded model, produced once per upload.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Number of instances per IFC class, keyed by class name (e.g. IfcWall).",
          "type": "object"
        },
        "ifc_schema": {
          "description": "Schema identifier read from the file.",
          "examples": [
            "IFC4"
          ],
          "type": "string"
        },
        "model_hash": {
          "description": "Lower-case SHA-256 hex.",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "project_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "storeys": {
          "description": "Building storeys in file order.",
          "items": {
            "$ref": "#/$defs/ElementRef"
          },
          "type": "array"
        }
      },
      "required": [
        "ifc_schema",
        "model_hash",
        "project_name",
        "counts",
        "storeys"
      ],
      "title": "ModelSummary",
      "type": "object"
    },
    "PlannedCheck": {
      "additionalProperties": false,
      "description": "A plan item: which confirmed check to run and why. Never carries parameters.",
      "properties": {
        "check_id": {
          "minLength": 1,
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "reason"
      ],
      "title": "PlannedCheck",
      "type": "object"
    },
    "ProblemDetail": {
      "additionalProperties": false,
      "description": "``application/problem+json`` body.",
      "properties": {
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Request correlation id for matching against the run log."
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Occurrence-specific explanation."
        },
        "instance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URI of the specific occurrence."
        },
        "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        "title": {
          "description": "Short, stable summary of the problem type.",
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "default": "about:blank",
          "description": "URI identifying the problem type.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "correlation_id"
      ],
      "title": "ProblemDetail",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A single reviewable requirement bound to exactly one CheckSpec.",
      "properties": {
        "check": {
          "$ref": "#/$defs/CheckSpec"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model self-report; a sorting aid only."
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Revision the user confirmed, if any."
        },
        "id": {
          "examples": [
            "REQ-001"
          ],
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "enum": [
            "document",
            "ids",
            "builtin"
          ],
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "statement": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed",
            "edited",
            "rejected",
            "informational"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "statement",
        "origin",
        "source",
        "check",
        "status",
        "confidence",
        "revision",
        "confirmed_revision",
        "confirmed_by",
        "confirmed_at"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RequirementSource": {
      "additionalProperties": false,
      "description": "Where a document-derived requirement came from; the quote is verbatim (FR-REQ-02).",
      "properties": {
        "document_id": {
          "minLength": 1,
          "type": "string"
        },
        "location": {
          "description": "Paragraph or page identifier.",
          "minLength": 1,
          "type": "string"
        },
        "quote": {
          "description": "Exact substring of the extracted text.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "location",
        "quote"
      ],
      "title": "RequirementSource",
      "type": "object"
    },
    "ReviewPlan": {
      "additionalProperties": false,
      "description": "The ordered set of checks a run intends to execute (plan-then-execute, C-01).",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/PlannedCheck"
          },
          "type": "array"
        }
      },
      "required": [
        "checks"
      ],
      "title": "ReviewPlan",
      "type": "object"
    },
    "ReviewRun": {
      "additionalProperties": false,
      "description": "One review run over a session; the only record that carries timestamps.",
      "properties": {
        "check_results": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "input_manifest": {
          "$ref": "#/$defs/InputManifest"
        },
        "plan": {
          "$ref": "#/$defs/ReviewPlan"
        },
        "plan_source": {
          "enum": [
            "llm",
            "default"
          ],
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "partial",
            "failed",
            "interrupted"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "session_id",
        "status",
        "plan",
        "plan_source",
        "check_results",
        "input_manifest",
        "created_at",
        "finished_at"
      ],
      "title": "ReviewRun",
      "type": "object"
    }
  },
  "$id": "https://github.com/natnew/BIM-Intelligence/schemas/contracts.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from backend/bim_intelligence/schemas by scripts/export_schemas.py. Do not edit by hand.",
  "properties": {
    "checkResult": {
      "$ref": "#/$defs/CheckResult"
    },
    "checkSpec": {
      "$ref": "#/$defs/CheckSpec"
    },
    "elementRef": {
      "$ref": "#/$defs/ElementRef"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "inputManifest": {
      "$ref": "#/$defs/InputManifest"
    },
    "modelSummary": {
      "$ref": "#/$defs/ModelSummary"
    },
    "plannedCheck": {
      "$ref": "#/$defs/PlannedCheck"
    },
    "problemDetail": {
      "$ref": "#/$defs/ProblemDetail"
    },
    "requirement": {
      "$ref": "#/$defs/Requirement"
    },
    "requirementSource": {
      "$ref": "#/$defs/RequirementSource"
    },
    "reviewPlan": {
      "$ref": "#/$defs/ReviewPlan"
    },
    "reviewRun": {
      "$ref": "#/$defs/ReviewRun"
    }
  },
  "title": "BimIntelligenceContracts",
  "type": "object"
}
