{
  "name": "bim-intelligence-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:generate": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check"
  },
  "dependencies": {
    "@thatopen/components": "3.6.0",
    "@thatopen/components-front": "3.6.0",
    "@thatopen/fragments": "3.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.182.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^6.2.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Interactive BIM review interface for BIM Intelligence",
  "license": "MIT"
}
