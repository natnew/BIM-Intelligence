# ---------------------------------------------------------------------------
# BIM Intelligence — environment configuration template
# Copy to `.env` (git-ignored) and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime profile --------------------------------------------------------
# Local development and automated tests stay offline by default.
# A production process must set BIMI_ENVIRONMENT=production and configure the
# approved live provider below; it will refuse to start with development Off settings.
BIMI_ENVIRONMENT=development

# --- Meta Model API ---------------------------------------------------------
# API key from https://dev.meta.ai (format LLM_<id>_<secret>). Required for live LLM calls.
MODEL_API_KEY=
# OpenAI-compatible base URL for the Meta Model API.
LLM_BASE_URL=https://api.meta.ai/v1
# Standard-mode model id. Do NOT use "-contributor" variants: they permit training on your data.
LLM_MODEL=muse-spark-1.3
# live | replay | off
#   live   — call the API (requires MODEL_API_KEY and both live opt-in gates)
#   replay — serve recorded responses from LLM_RECORDINGS_DIR (deterministic, free)
#   off    — deterministic pipeline only; default plan and templated explanations
LLM_MODE=off
LLM_RECORDINGS_DIR=tests/evaluation/recordings
# Additional explicit opt-in required when LLM_MODE=live.
ALLOW_LIVE_LLM=false
# Safety switch: set to true only with explicit approval.
ALLOW_CONTRIBUTOR_MODELS=false
# Request timeout (seconds). Retries remain disabled during T-5 integration.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0

# --- Orchestration limits ---------------------------------------------------
MAX_TOOL_CALLS_PER_RUN=12
MAX_PLAN_CHECKS=10
MAX_INPUT_TOKENS_PER_RUN=150000

# --- Muse Spark Standard pricing (USD per 1M tokens; verify before live use) --
LLM_PRICE_INPUT_PER_M=1.25
LLM_PRICE_CACHED_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=4.25
# Application-level safeguards; these are not provider-enforced spending caps.
LLM_MAX_INPUT_TOKENS_PER_CALL=8000
LLM_MAX_OUTPUT_TOKENS_PER_CALL=500
# Objective review planning has a separate completion allowance; other workflows retain 500.
LLM_MAX_PLANNING_OUTPUT_TOKENS=2000
LLM_MAX_CALLS_PER_RUN=2
LLM_MAX_CALL_BUDGET_USD=0.10
LLM_MAX_RUN_BUDGET_USD=0.10
LLM_PROJECT_BUDGET_USD=5.00

# --- Server -----------------------------------------------------------------
BIMI_HOST=127.0.0.1
BIMI_PORT=8000
# Refuse to bind to a non-loopback address unless explicitly allowed.
ALLOW_REMOTE=false
# Comma-separated origins allowed by CORS (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Storage and upload limits ----------------------------------------------
DATA_DIR=data
MAX_IFC_MB=200
MAX_DOC_MB=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend (Vite reads variables prefixed VITE_) --------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
