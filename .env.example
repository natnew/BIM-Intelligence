# ---------------------------------------------------------------------------
# BIM Intelligence — environment configuration template
# Copy to `.env` (git-ignored) and fill in values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Meta Model API ---------------------------------------------------------
# API key from https://dev.meta.ai (format LLM_<id>_<secret>). Required for live LLM calls.
MODEL_API_KEY=
# OpenAI-compatible base URL for the Meta Model API.
LLM_BASE_URL=https://api.meta.ai/v1
# Standard-mode model id. Do NOT use "-contributor" variants: they permit training on your data.
LLM_MODEL=muse-spark-1.3
# live | replay | off
#   live   — call the API (requires MODEL_API_KEY and spend authorisation)
#   replay — serve recorded responses from LLM_RECORDINGS_DIR (deterministic, free)
#   off    — deterministic pipeline only; default plan and templated explanations
LLM_MODE=off
LLM_RECORDINGS_DIR=tests/evaluation/recordings
# Safety switch: set to true only with explicit approval.
ALLOW_CONTRIBUTOR_MODELS=false
# Request timeout (seconds) and retry count for 429/5xx responses.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Orchestration limits ---------------------------------------------------
MAX_TOOL_CALLS_PER_RUN=12
MAX_PLAN_CHECKS=10
MAX_INPUT_TOKENS_PER_RUN=150000

# --- Cost estimation (USD per 1M tokens; indicative, re-check pricing page) --
LLM_PRICE_INPUT_PER_M=1.25
LLM_PRICE_OUTPUT_PER_M=4.25

# --- Server -----------------------------------------------------------------
BIMI_HOST=127.0.0.1
BIMI_PORT=8000
# Refuse to bind to a non-loopback address unless explicitly allowed.
ALLOW_REMOTE=false
# Comma-separated origins allowed by CORS (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# --- Storage and upload limits ----------------------------------------------
DATA_DIR=data
MAX_IFC_MB=200
MAX_DOC_MB=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend (Vite reads variables prefixed VITE_) --------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
