# ---------------------------------------------------------------------------
# Confidential project material — never commit
# ---------------------------------------------------------------------------
hackathon-private/
*.private.*

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# Runtime data: uploaded models, documents, session state, reports
# ---------------------------------------------------------------------------
data/
!data/README.md
uploads/
reports/
*.bcf
*.bcfzip

# Generated benchmark outputs are rebuilt by datasets/generate.py
datasets/**/generated/
tests/evaluation/runs/

# Binary BIM inputs are allowed only in curated fixture and dataset locations
*.ifc
*.ifczip
*.ifcxml
!tests/fixtures/**/*.ifc
!datasets/synthetic/**/*.ifc
!datasets/permitted/**/*.ifc
*.frag

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Logs, traces, evaluation outputs, scratch
# ---------------------------------------------------------------------------
logs/
*.log
traces/
tmp/
scratch/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
